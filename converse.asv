clc;
clear;

%% ===============================
%        USER INPUTS
% ===============================

job_name  = '3027';          % حداکثر 8 بایت ASCII
line1     = '30% wool';
line2     = 'iran order';
font_size = 18;

output_file = 'output.ejp';

%% ===============================
%   RENDER TEXT TO BITMAP
% ===============================

fig = figure('Visible','off','Color','white','Position',[100 100 300 800]);
ax  = axes(fig);
axis(ax,'off');

text(0.05,0.8,line1,'FontSize',font_size,...
    'FontName','Arial','Color','black','Interpreter','none');

text(0.05,0.6,line2,'FontSize',font_size,...
    'FontName','Arial','Color','black','Interpreter','none');

frame = getframe(fig);
img   = rgb2gray(frame.cdata);
close(fig);

BW = imbinarize(img);
BW = ~BW;   % مشکی = 1 ، سفید = 0

%% ===============================
%   FIX WIDTH TO 64 BITS
% ===============================

BW = imresize(BW,[size(BW,1) 64],'nearest');
img_matrix = double(BW);

n_rows = size(img_matrix,1);
bytes_per_row = 8;

%% ===============================
%   BITMAP → EJP IMAGE DATA
% ===============================

ejp_image_data = zeros(n_rows * bytes_per_row,1,'uint8');

for r = 1:n_rows
    for b = 1:bytes_per_row
        bits = img_matrix(r,(b-1)*8+1:b*8);
        ejp_image_data((r-1)*8 + b) = bi2de(bits,'left-msb');
    end
end

%% ===============================
%        BUILD HEADER (28B)
% ===============================

header = zeros(28,1,'uint8');

% bytes 1–8 : job name
name_bytes = uint8(job_name);
header(1:min(8,length(name_bytes))) = name_bytes(1:min(8,end));

% bytes 9–16 : ثابت
header(9:16) = uint8([40 00 08 05 00 00 00 00]);

% byte 17 : image height
header(17) = uint8(n_rows);

% bytes 18–20 : ثابت
header(18:20) = uint8([06 08 00]);

% bytes 21–28 : ELTEX UK
header(21:28) = uint8('ELTEX UK');

%% ===============================
%        WRITE EJP FILE
% ===============================

fid = fopen(output_file,'w');
fwrite(fid,header,'uint8');
fwrite(fid,ejp_image_data,'uint8');
fclose(fid);

%% ===============================
%        PREVIEW BITMAP
% ===============================

figure;
imshow(img_matrix,'InitialMagnification','fit');
colormap(gray(2));
axis on;

disp('EJP file generated successfully.');
fprintf('Rows: %d | Bytes: %d\n', n_rows, length(ejp_image_data));
