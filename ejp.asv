% ---------------------------
% تنظیمات
% ---------------------------
filename = 'input.ejp';
startPos = hex2dec('0C');  % شروع واقعی از بایت 0x0C
num_bytes = 8;              % فقط 8 بایت → 64 بیت

% ---------------------------
% خواندن فایل
% ---------------------------
fid = fopen(filename, 'rb');
fseek(fid, startPos, 'bof');
raw = fread(fid, num_bytes, 'uint8');
fclose(fid);

% ---------------------------
% تبدیل بایت → بیت → ماتریس 8x8
% ---------------------------
image_bits = zeros(8, 8); % 8 سطر، 8 ستون

idx = 1;
for r = 1:8
    byte = raw(r);
    image_bits(r, :) = bitget(byte, 8:-1:1);  % بیت‌ها از چپ به راست
end

% ---------------------------
% ساخت تصویر
% ---------------------------
% 1 = مشکی، 0 = سفید
img = uint8(~image_bits * 255);

% ---------------------------
% نمایش تصویر
% ---------------------------
figure;
imshow(img);
title('First 64 bits (8x8)');

figure;
imshow(imresize(img, 20, 'nearest')); % بزرگنمایی ×20 برای دید بهتر
title('Zoom ×20');
